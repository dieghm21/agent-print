# Configuración del Agente de Impresoras Térmicas

# Puerto donde se ejecutará el servidor
PORT=3001

# Host para escuchar
HOST=127.0.0.1

# Nivel de log (error, warn, info, debug)
LOG_LEVEL=info

# Ruta para almacenar logs
LOG_PATH=./logs

# Timeout para operaciones de impresión (ms)
PRINT_TIMEOUT=30000

# Tiempo máximo de cola de espera
MAX_QUEUE_SIZE=100

# Habilitar CORS para orígenes específicos
CORS_ORIGIN=http://localhost:3000,http://localhost:4200

# Intervalo de escaneo de dispositivos USB (ms)
DEVICE_SCAN_INTERVAL=10000

# Reintentos automáticos en caso de fallo
AUTO_RETRY=true
RETRY_ATTEMPTS=3
RETRY_DELAY=2000
